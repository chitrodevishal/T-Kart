# T-Kart Backend Environment Variables Template
# Copy this file to .env and replace placeholder values with your actual configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS configuration)
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas Connection String)
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/tkart_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/tkart_db?retryWrites=true&w=majority

# Optional: comma-separated DNS servers if Node cannot resolve Atlas SRV records
# NODE_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Initial Admin Setup Seed (Used during admin setup script)
ADMIN_NAME=replace_with_your_admin_name
ADMIN_EMAIL=replace_with_your_admin_email@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_chars
ADMIN_PHONE=replace_with_your_admin_phone

# Optional product image search (fallback images are used when unset or unavailable)
PEXELS_API_KEY=replace_with_your_pexels_api_key
PEXELS_IMAGE_TIMEOUT_MS=4000
PEXELS_IMAGE_CACHE_TTL_MS=86400000
PEXELS_IMAGE_FAILURE_CACHE_TTL_MS=60000
PEXELS_IMAGE_CACHE_MAX_ENTRIES=1000
