{
  "name": "t-kart-backend",
  "version": "1.0.0",
  "description": "T-Kart E-Commerce REST API Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:atlas": "node server.js",
    "dev:atlas": "node --watch server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:admin:atlas": "node scripts/seedAdmin.js",
    "seed:catalog": "node scripts/seedCatalog.js",
    "seed:catalog:atlas": "node scripts/seedCatalog.js",
    "seed:dummyjson": "node scripts/seedDummyJsonProducts.js",
    "seed:dummyjson:atlas": "node scripts/seedDummyJsonProducts.js",
    "migrate:product-images": "node scripts/migrateProductImages.js",
    "migrate:product-images:atlas": "node scripts/migrateProductImages.js",
    "migrate:product-discounts": "node scripts/migrateProductDiscounts.js",
    "migrate:product-discounts:atlas": "node scripts/migrateProductDiscounts.js",
    "clear:orders:atlas": "node scripts/clearOrders.js --confirm=clear-all-orders",
    "test:auth": "node scripts/testAuth.js",
    "test:product-images": "node --test",
    "test:product-images:integration": "node scripts/runProductImageIntegration.js",
    "test:dummyjson": "node --test tests/dummyJsonImporter.test.js",
    "test:dummyjson:integration": "node scripts/runDummyJsonIntegration.js",
    "verify:models": "node scripts/verifyModels.js",
    "verify:models:atlas": "node scripts/verifyModels.js"
  },
  "keywords": [
    "ecommerce",
    "mern",
    "express",
    "api",
    "tkart"
  ],
  "author": "T-Kart Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.10.0"
  }
}
